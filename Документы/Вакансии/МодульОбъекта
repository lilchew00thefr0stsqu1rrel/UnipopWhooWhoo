&НаСервере
Функция ПодобратьРезюме() Экспорт
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ВсеРезюме.Регистратор КАК Регистратор,  
	 |	ВсеРезюме.Профессия КАК Профессия,
	 |	ВсеРезюме.ФорматРаботы КАК ФорматРаботы
	 |ИЗ
	 |	РегистрСведений.ВсеРезюме КАК ВсеРезюме";
	 
	 Результат = Запрос.Выполнить();
	 ВыборкаДетальныеЗаписи = Результат.Выбрать();
	  
	 ПредыдОчкиСоответствия = 0;
		 
	 Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		 ОчкиСоответствия = 0;          
		 
		 Если Образование.Ссылка = ВыборкаДетальныеЗаписи.Профессия Тогда			 
		 		ОчкиСоответствия = ОчкиСоответствия + 5;   
		 КонецЕсли; 
		 
		 Если ФорматРаботы = ВыборкаДетальныеЗаписи.ФорматРаботы Тогда
			 ОчкиСоответствия = ОчкиСоответствия + 4;   
		 КонецЕсли; 			
		
		                             
		 
		 Если ОчкиСоответствия >= ПредыдОчкиСоответствия Тогда
			ВозможноПодходящееРезюме = 
			ВыборкаДетальныеЗаписи.Регистратор;
     
		    ПредыдОчкиСоответствия = ОчкиСоответствия;

		КонецЕсли;  
                                      
	 КонецЦикла;

      
Сообщить(ВозможноПодходящееРезюме);

Возврат ВозможноПодходящееРезюме;
	 
КонецФункции           


&НаСервере
Функция ПодобратьСопрПисьмо() Экспорт
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ВсеСопроводительныеПисьма.Резюме КАК Резюме,
	 |	ВсеСопроводительныеПисьма.Письмо КАК Письмо,
	 |	ВсеСопроводительныеПисьма.Автор КАК Автор,
	 |	ВсеСопроводительныеПисьма.Регистратор КАК Регистратор
	 |ИЗ
	 |	РегистрСведений.ВсеСопроводительныеПисьма КАК ВсеСопроводительныеПисьма";
	 
	 Результат = Запрос.Выполнить();
	 ВыборкаДетальныеЗаписи = Результат.Выбрать();   
	 
	 ВозможноПодходящееРезюме = ПодобратьРезюме();
	                            		 
	 Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		 
		 
		 Сообщить(ВозможноПодходящееРезюме);
		 
		 Если ВозможноПодходящееРезюме = ВыборкаДетальныеЗаписи.Резюме Тогда
			 ПисьмоКВозможноПодходящемуРезюме = ВыборкаДетальныеЗаписи.Регистратор;
		 КонецЕсли;
		 
	 КонецЦикла;

      
Сообщить(ВозможноПодходящееРезюме);

Возврат ПисьмоКВозможноПодходящемуРезюме;
	 
КонецФункции
