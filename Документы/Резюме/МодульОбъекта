Функция ПодобратьВакансию() Экспорт
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ВсеВакансии.Регистратор КАК Регистратор,
	 |	ВсеВакансии.Образование КАК Образование,
	 |	ВсеВакансии.ФорматРаботы КАК ФорматРаботы
	 |ИЗ
	 |	РегистрСведений.ВсеВакансии КАК ВсеВакансии";
	 
	 Результат = Запрос.Выполнить();
	 ВыборкаДетальныеЗаписи = Результат.Выбрать();
	  
	 ПредыдОчкиСоответствия = 0;
		 
	 Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		 ОчкиСоответствия = 0;          
		 
		 Если Профессия.Ссылка = ВыборкаДетальныеЗаписи.Образование Тогда			 
		 		ОчкиСоответствия = ОчкиСоответствия + 5;   
		 КонецЕсли; 
		 
		 Для Каждого ФР Из ФорматРаботы Цикл
			 Если ФР.ФорматРаботы = ВыборкаДетальныеЗаписи.ФорматРаботы Тогда
			 ОчкиСоответствия = ОчкиСоответствия + 4;   
		 КонецЕсли;
		 КонецЦикла;
			
		
		                             
		 
		 Если ОчкиСоответствия >= ПредыдОчкиСоответствия Тогда
			ВозможноПодходящаяВакансия = 
			ВыборкаДетальныеЗаписи.Регистратор;
     
		    ПредыдОчкиСоответствия = ОчкиСоответствия;

	     КонецЕсли;
	
КонецЦикла;   


      
Сообщить(ВозможноПодходящаяВакансия);

Возврат ВозможноПодходящаяВакансия;
	 
